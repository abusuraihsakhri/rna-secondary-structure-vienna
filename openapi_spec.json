{
  "openapi": "3.1.0",
  "info": {
    "title": "RNA Secondary Structure Vienna API",
    "description": "Informational route outline. The running FastAPI server exposes the authoritative generated schema at /openapi.json. Includes ViennaRNA MFE folding and legacy numeric-threshold auditing.",
    "version": "2.1",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus operational metrics",
        "responses": {
          "200": {
            "description": "JSON metrics snapshot (not Prometheus text)"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Legacy numeric threshold evaluation; not RNA folding",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock supervisor response; no external model inference",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Read in-memory audit metadata and HMAC verification state (no authentication)",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/fold": {
      "post": {
        "summary": "Compute true RNA minimum-free-energy structure using the installed ViennaRNA bindings",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sequence": {
                    "type": "string",
                    "description": "One A/C/G/U RNA sequence or FASTA entry (T is normalized to U); maximum 500 nt"
                  }
                },
                "required": [
                  "sequence"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Dot-bracket MFE, kcal/mol energy, sequence and base pairs"
          },
          "422": {
            "description": "Invalid or unsupported sequence"
          },
          "503": {
            "description": "ViennaRNA dependency not installed"
          }
        }
      }
    }
  }
}
